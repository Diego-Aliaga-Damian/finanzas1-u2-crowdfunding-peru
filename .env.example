# Plantilla de variables de entorno. Copie este archivo como .env y complete si lo desea.
# Ninguna de las fuentes usadas (BCRPData, API OData de la SMV, portal SIMV de la SMV) exige clave de API.

# Contacto opcional que se añade al User-Agent identificable (p. ej., un correo institucional).
CONTACTO_UA=

# Pausa mínima entre solicitudes, en segundos. El código nunca usa menos de 1 s (numeral 2.4.8).
PAUSA_SEGUNDOS=
